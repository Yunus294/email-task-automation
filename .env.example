# server
PORT=3000

# database
MONGODB_URI=mongodb://127.0.0.1:27017/email-task-automation
# set to true if you don't have mongo installed, the app will spin up an in-memory one
USE_MEMORY_DB=false

# shared secret the email provider sends in the x-webhook-token header
WEBHOOK_TOKEN=dev-webhook-token

# openai - paste your key here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# set to true to use a dumb keyword-based classifier instead of openai (for local testing without a key)
LLM_FAKE=false
